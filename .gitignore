frontend/src-tauri/gen/

# ── App data (never commit weights / caches / DB) ────────────────
*.onnx
models/
*.sqlite
*.sqlite-*
*.db
.image-sorter/
thumbs-cache/

# ── Editor / OS ───────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

