{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Image Sorter",
  "version": "0.1.0",
  "identifier": "com.flytheonlyone.imagesorter",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "bun run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Image Sorter",
        "label": "main",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:* data: blob: asset: https://asset.localhost; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/image-sorter-sidecar"],
    "resources": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
