    "tauri:prepare-sidecar": "bun run scripts/prepare-tauri-sidecar.ts",
    "build:app": "bun run tauri:prepare-sidecar && bun run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
