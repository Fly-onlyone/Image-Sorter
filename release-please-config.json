{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        { "type": "json", "path": "frontend/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "frontend/src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" }
      ]
    }
  }
}
